rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidLogoWidth(w) {
      return (w is int || w is float) && w >= 20 && w <= 180;
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'email', 'reportTitle', 'namaSppg', 'idSppg',
          'alamat', 'kabKota', 'provinsi', 'namaSppi', 'nomorHp',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'reportTitle', 'namaSppg', 'idSppg',
          'alamat', 'kabKota', 'provinsi', 'namaSppi', 'nomorHp',
          'logoSettings', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.reportTitle is string && data.reportTitle.size() >= 1 && data.reportTitle.size() <= 100
        && data.namaSppg is string && data.namaSppg.size() >= 1 && data.namaSppg.size() <= 150
        && data.idSppg is string && data.idSppg.size() >= 1 && data.idSppg.size() <= 40
        && data.alamat is string && data.alamat.size() <= 300
        && data.kabKota is string && data.kabKota.size() <= 100
        && data.provinsi is string && data.provinsi.size() <= 100
        && data.namaSppi is string && data.namaSppi.size() <= 150
        && data.nomorHp is string && data.nomorHp.size() <= 30
        && (!('logoSettings' in data) || (data.logoSettings is map && data.logoSettings.size() <= 16))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMonthlyArchive(data) {
      return data.keys().hasAll([
          'uid', 'monthKey', 'year', 'month', 'periodeLabel',
          'entryCount', 'photoCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'monthKey', 'year', 'month', 'periodeLabel',
          'entryCount', 'photoCount', 'selectedCategories', 'akgTargets',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.year is int && data.year >= 2020 && data.year <= 2100
        && data.month is int && data.month >= 1 && data.month <= 12
        && data.periodeLabel is string && data.periodeLabel.size() >= 1 && data.periodeLabel.size() <= 40
        && data.entryCount is int && data.entryCount >= 0 && data.entryCount <= 366
        && data.photoCount is int && data.photoCount >= 0 && data.photoCount <= 366
        && (
          !('selectedCategories' in data) || (
            data.selectedCategories is list
            && data.selectedCategories.size() <= 15
            && data.selectedCategories.hasOnly([
              'tk_paud_lb', 'sd_1_3', 'sd_4_6', 'smp_mts', 'sma_smk',
              'pendidik', 'tendik', 'anak_balita', 'balita_13_59',
              'balita_6_11', 'ibu_hamil', 'ibu_menyusui'
            ])
          )
        )
        && (!('akgTargets' in data) || (data.akgTargets is map && data.akgTargets.size() <= 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyMenuEntry(data) {
      return data.keys().hasAll([
          'uid', 'monthKey', 'dateIso', 'hariKe', 'namaMenu',
          'photoDataUrl', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'monthKey', 'dateIso', 'hariKe', 'namaMenu',
          'photoDataUrl', 'nutritionByCategory', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.dateIso is string && data.dateIso.size() == 10 && data.dateIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.hariKe is int && data.hariKe >= 1 && data.hariKe <= 366
        && data.namaMenu is string && data.namaMenu.size() >= 1 && data.namaMenu.size() <= 1000
        && data.photoDataUrl is string && data.photoDataUrl.size() <= 350000
        && (!('nutritionByCategory' in data) || (data.nutritionByCategory is map && data.nutritionByCategory.size() <= 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSampleFormConfig(data) {
      return data.keys().hasAll([
          'uid', 'monthKey', 'logoCaption', 'unitName', 'formLabel', 'formTitle',
          'docNumber', 'revision', 'effectiveDate', 'bulanLabel', 'tahunLabel',
          'verifierLine1', 'verifierLine2', 'verifierName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'monthKey', 'logoDataUrl', 'logoWidthPx', 'logoRightDataUrl', 'logoRightWidthPx',
          'followGlobalLeftLogo', 'followGlobalRightLogo',
          'logoCaption', 'unitName', 'formLabel', 'formTitle',
          'docNumber', 'revision', 'effectiveDate', 'bulanLabel', 'tahunLabel',
          'colLabels', 'verifierLine1', 'verifierLine2', 'verifierName', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && (!('logoDataUrl' in data) || (data.logoDataUrl is string && data.logoDataUrl.size() <= 200000))
        && (!('logoWidthPx' in data) || isValidLogoWidth(data.logoWidthPx))
        && (!('logoRightDataUrl' in data) || (data.logoRightDataUrl is string && data.logoRightDataUrl.size() <= 200000))
        && (!('logoRightWidthPx' in data) || isValidLogoWidth(data.logoRightWidthPx))
        && (!('followGlobalLeftLogo' in data) || data.followGlobalLeftLogo is bool)
        && (!('followGlobalRightLogo' in data) || data.followGlobalRightLogo is bool)
        && data.logoCaption is string && data.logoCaption.size() <= 80
        && data.unitName is string && data.unitName.size() <= 150
        && data.formLabel is string && data.formLabel.size() <= 60
        && data.formTitle is string && data.formTitle.size() <= 100
        && data.docNumber is string && data.docNumber.size() <= 60
        && data.revision is string && data.revision.size() <= 30
        && data.effectiveDate is string && data.effectiveDate.size() <= 60
        && data.bulanLabel is string && data.bulanLabel.size() <= 40
        && data.tahunLabel is string && data.tahunLabel.size() <= 20
        && (!('colLabels' in data) || (data.colLabels is map && data.colLabels.size() <= 16))
        && data.verifierLine1 is string && data.verifierLine1.size() <= 80
        && data.verifierLine2 is string && data.verifierLine2.size() <= 80
        && data.verifierName is string && data.verifierName.size() <= 150
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSamplePertinggalRow(data) {
      return data.keys().hasAll([
          'uid', 'monthKey', 'rowOrder', 'kodeIdentitas', 'jumlahSampel',
          'kondisiOk', 'kondisiNok', 'penanggungJawab', 'masukTanggal',
          'masukJam', 'keluarTanggal', 'keluarJam', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'monthKey', 'rowOrder', 'kodeIdentitas', 'jumlahSampel',
          'kondisiOk', 'kondisiNok', 'penanggungJawab', 'masukTanggal',
          'masukJam', 'keluarTanggal', 'keluarJam', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.rowOrder is int && data.rowOrder >= 1 && data.rowOrder <= 500
        && data.kodeIdentitas is string && data.kodeIdentitas.size() <= 150
        && data.jumlahSampel is string && data.jumlahSampel.size() <= 60
        && data.kondisiOk is string && data.kondisiOk.size() <= 20
        && data.kondisiNok is string && data.kondisiNok.size() <= 20
        && data.penanggungJawab is string && data.penanggungJawab.size() <= 150
        && data.masukTanggal is string && data.masukTanggal.size() <= 60
        && data.masukJam is string && data.masukJam.size() <= 30
        && data.keluarTanggal is string && data.keluarTanggal.size() <= 60
        && data.keluarJam is string && data.keluarJam.size() <= 30
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTempFormConfig(data) {
      return data.keys().hasAll([
          'uid', 'monthKey', 'logoCaption', 'unitName', 'formLabel', 'formTitle',
          'docNumber', 'revision', 'effectiveDate', 'periodeLabel',
          'sopTitle', 'sopSubtitle', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'monthKey', 'logoDataUrl', 'logoWidthPx', 'logoRightDataUrl', 'logoRightWidthPx',
          'followGlobalLeftLogo', 'followGlobalRightLogo',
          'logoCaption', 'unitName', 'formLabel', 'formTitle',
          'docNumber', 'revision', 'effectiveDate', 'periodeLabel', 'tableLabels',
          'sopTitle', 'sopSubtitle', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && (!('logoDataUrl' in data) || (data.logoDataUrl is string && data.logoDataUrl.size() <= 200000))
        && (!('logoWidthPx' in data) || isValidLogoWidth(data.logoWidthPx))
        && (!('logoRightDataUrl' in data) || (data.logoRightDataUrl is string && data.logoRightDataUrl.size() <= 200000))
        && (!('logoRightWidthPx' in data) || isValidLogoWidth(data.logoRightWidthPx))
        && (!('followGlobalLeftLogo' in data) || data.followGlobalLeftLogo is bool)
        && (!('followGlobalRightLogo' in data) || data.followGlobalRightLogo is bool)
        && data.logoCaption is string && data.logoCaption.size() <= 80
        && data.unitName is string && data.unitName.size() <= 150
        && data.formLabel is string && data.formLabel.size() <= 60
        && data.formTitle is string && data.formTitle.size() <= 120
        && data.docNumber is string && data.docNumber.size() <= 60
        && data.revision is string && data.revision.size() <= 30
        && data.effectiveDate is string && data.effectiveDate.size() <= 60
        && data.periodeLabel is string && data.periodeLabel.size() <= 60
        && (!('tableLabels' in data) || (data.tableLabels is map && data.tableLabels.size() <= 16))
        && data.sopTitle is string && data.sopTitle.size() <= 150
        && data.sopSubtitle is string && data.sopSubtitle.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTempMonitoringRoom(data) {
      return data.keys().hasAll([
          'uid', 'monthKey', 'roomOrder', 'roomName', 'presetKey',
          'standardSuhu', 'standardRh', 'sopNote', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'monthKey', 'roomOrder', 'roomName', 'presetKey',
          'standardSuhu', 'standardRh', 'sopNote', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.roomOrder is int && data.roomOrder >= 1 && data.roomOrder <= 200
        && data.roomName is string && data.roomName.size() >= 1 && data.roomName.size() <= 120
        && data.presetKey is string && data.presetKey.size() <= 60
        && data.standardSuhu is string && data.standardSuhu.size() <= 120
        && data.standardRh is string && data.standardRh.size() <= 80
        && data.sopNote is string && data.sopNote.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTempDayReading(data) {
      return data.keys().hasAll([
          'uid', 'monthKey', 'roomId', 'day', 'jam', 'suhu', 'rh',
          'paraf', 'namaPetugas', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'monthKey', 'roomId', 'day', 'jam', 'suhu', 'rh',
          'paraf', 'namaPetugas', 'photoDataUrl', 'detectedNote',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128
        && data.day is int && data.day >= 1 && data.day <= 31
        && data.jam is string && data.jam.size() <= 20
        && data.suhu is string && data.suhu.size() <= 30
        && data.rh is string && data.rh.size() <= 30
        && data.paraf is string && data.paraf.size() <= 40
        && data.namaPetugas is string && data.namaPetugas.size() <= 120
        && (!('photoDataUrl' in data) || (data.photoDataUrl is string && data.photoDataUrl.size() <= 180000))
        && (!('detectedNote' in data) || (data.detectedNote is string && data.detectedNote.size() <= 250))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFreezerFormConfig(data) {
      return data.keys().hasAll([
          'uid', 'monthKey', 'logoCaption', 'unitName', 'formLabel', 'formTitle',
          'docNumber', 'revision', 'effectiveDate', 'periodeLabel',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'monthKey', 'logoDataUrl', 'logoWidthPx', 'logoRightDataUrl', 'logoRightWidthPx',
          'followGlobalLeftLogo', 'followGlobalRightLogo',
          'logoCaption', 'unitName', 'formLabel', 'formTitle',
          'docNumber', 'revision', 'effectiveDate', 'periodeLabel', 'colLabels',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && (!('logoDataUrl' in data) || (data.logoDataUrl is string && data.logoDataUrl.size() <= 200000))
        && (!('logoWidthPx' in data) || isValidLogoWidth(data.logoWidthPx))
        && (!('logoRightDataUrl' in data) || (data.logoRightDataUrl is string && data.logoRightDataUrl.size() <= 200000))
        && (!('logoRightWidthPx' in data) || isValidLogoWidth(data.logoRightWidthPx))
        && (!('followGlobalLeftLogo' in data) || data.followGlobalLeftLogo is bool)
        && (!('followGlobalRightLogo' in data) || data.followGlobalRightLogo is bool)
        && data.logoCaption is string && data.logoCaption.size() <= 80
        && data.unitName is string && data.unitName.size() <= 150
        && data.formLabel is string && data.formLabel.size() <= 60
        && data.formTitle is string && data.formTitle.size() <= 120
        && data.docNumber is string && data.docNumber.size() <= 60
        && data.revision is string && data.revision.size() <= 30
        && data.effectiveDate is string && data.effectiveDate.size() <= 60
        && data.periodeLabel is string && data.periodeLabel.size() <= 60
        && (!('colLabels' in data) || (data.colLabels is map && data.colLabels.size() <= 24))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFreezerMachine(data) {
      return data.keys().hasAll([
          'uid', 'monthKey', 'machineOrder', 'machineType', 'namaMesin',
          'merk', 'noMesin', 'lokasi', 'normalSuhuBgn', 'bgnSopNote',
          'conclusionHeader', 'repairPrompt', 'repairNote', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'monthKey', 'machineOrder', 'machineType', 'namaMesin',
          'merk', 'noMesin', 'lokasi', 'normalSuhuBgn', 'bgnSopNote',
          'conclusionHeader', 'repairPrompt', 'repairNote', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.machineOrder is int && data.machineOrder >= 1 && data.machineOrder <= 200
        && data.machineType in ['freezer', 'chiller']
        && data.namaMesin is string && data.namaMesin.size() >= 1 && data.namaMesin.size() <= 120
        && data.merk is string && data.merk.size() <= 100
        && data.noMesin is string && data.noMesin.size() <= 100
        && data.lokasi is string && data.lokasi.size() <= 120
        && data.normalSuhuBgn is string && data.normalSuhuBgn.size() <= 120
        && data.bgnSopNote is string && data.bgnSopNote.size() <= 300
        && data.conclusionHeader is string && data.conclusionHeader.size() <= 100
        && data.repairPrompt is string && data.repairPrompt.size() <= 100
        && data.repairNote is string && data.repairNote.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFreezerLogRow(data) {
      return data.keys().hasAll([
          'uid', 'monthKey', 'machineId', 'rowOrder', 'noLabel', 'tanggal',
          'jamCek1', 'suhu1', 'pic1',
          'jamCek2', 'suhu2', 'pic2',
          'jamCek3', 'suhu3', 'pic3',
          'keterangan', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'monthKey', 'machineId', 'rowOrder', 'noLabel', 'tanggal',
          'jamCek1', 'suhu1', 'pic1',
          'jamCek2', 'suhu2', 'pic2',
          'jamCek3', 'suhu3', 'pic3',
          'keterangan', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.machineId is string && data.machineId.size() >= 1 && data.machineId.size() <= 128
        && data.rowOrder is int && data.rowOrder >= 1 && data.rowOrder <= 500
        && data.noLabel is string && data.noLabel.size() <= 20
        && data.tanggal is string && data.tanggal.size() <= 60
        && data.jamCek1 is string && data.jamCek1.size() <= 30
        && data.suhu1 is string && data.suhu1.size() <= 30
        && data.pic1 is string && data.pic1.size() <= 80
        && data.jamCek2 is string && data.jamCek2.size() <= 30
        && data.suhu2 is string && data.suhu2.size() <= 30
        && data.pic2 is string && data.pic2.size() <= 80
        && data.jamCek3 is string && data.jamCek3.size() <= 30
        && data.suhu3 is string && data.suhu3.size() <= 30
        && data.pic3 is string && data.pic3.size() <= 80
        && data.keterangan is string && data.keterangan.size() <= 250
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFoodTempFormConfig(data) {
      return data.keys().hasAll([
          'uid', 'monthKey', 'headerLine1', 'headerLine2', 'headerLine3', 'headerLine4',
          'titleMasak', 'titleOmpreng', 'bulanLabel', 'signerLine1', 'signerLine2',
          'signerName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'monthKey', 'logoLeftDataUrl', 'logoLeftWidthPx', 'logoRightDataUrl', 'logoRightWidthPx',
          'followGlobalLeftLogo', 'followGlobalRightLogo',
          'headerLine1', 'headerLine2', 'headerLine3', 'headerLine4',
          'titleMasak', 'titleOmpreng', 'bulanLabel', 'colLabels',
          'signerLine1', 'signerLine2', 'signerName', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && (!('logoLeftDataUrl' in data) || (data.logoLeftDataUrl is string && data.logoLeftDataUrl.size() <= 200000))
        && (!('logoLeftWidthPx' in data) || isValidLogoWidth(data.logoLeftWidthPx))
        && (!('logoRightDataUrl' in data) || (data.logoRightDataUrl is string && data.logoRightDataUrl.size() <= 200000))
        && (!('logoRightWidthPx' in data) || isValidLogoWidth(data.logoRightWidthPx))
        && (!('followGlobalLeftLogo' in data) || data.followGlobalLeftLogo is bool)
        && (!('followGlobalRightLogo' in data) || data.followGlobalRightLogo is bool)
        && data.headerLine1 is string && data.headerLine1.size() <= 120
        && data.headerLine2 is string && data.headerLine2.size() <= 150
        && data.headerLine3 is string && data.headerLine3.size() <= 150
        && data.headerLine4 is string && data.headerLine4.size() <= 250
        && data.titleMasak is string && data.titleMasak.size() <= 120
        && data.titleOmpreng is string && data.titleOmpreng.size() <= 120
        && data.bulanLabel is string && data.bulanLabel.size() <= 60
        && (!('colLabels' in data) || (data.colLabels is map && data.colLabels.size() <= 10))
        && data.signerLine1 is string && data.signerLine1.size() <= 100
        && data.signerLine2 is string && data.signerLine2.size() <= 150
        && data.signerName is string && data.signerName.size() <= 150
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFoodTempDayBlock(data) {
      return data.keys().hasAll([
          'uid', 'monthKey', 'sheetType', 'blockOrder', 'tanggal', 'paraf', 'items',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'monthKey', 'sheetType', 'blockOrder', 'tanggal', 'paraf', 'items',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.sheetType in ['masak', 'ompreng']
        && data.blockOrder is int && data.blockOrder >= 1 && data.blockOrder <= 200
        && data.tanggal is string && data.tanggal.size() <= 60
        && data.paraf is string && data.paraf.size() <= 60
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 20 && data.items[0] is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTkpiSyncConfig(data) {
      return data.keys().hasAll([
          'uid', 'spreadsheetUrl', 'lastSyncedAt', 'syncedItems', 'customItems', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'spreadsheetUrl', 'lastSyncedAt', 'syncedItems', 'customItems', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.spreadsheetUrl is string && data.spreadsheetUrl.size() <= 500
        && data.lastSyncedAt is string && data.lastSyncedAt.size() <= 60
        && data.syncedItems is list && data.syncedItems.size() <= 1500
        && data.customItems is list && data.customItems.size() <= 500
        && data.updatedAt is timestamp;
    }

    function isValidDailyPmRecord(data) {
      return data.keys().hasAll([
          'uid', 'monthKey', 'dateIso', 'hariKe', 'headerLine1', 'headerLine2',
          'headerLine3', 'headerAlamat', 'titleSpecific', 'titleSummary',
          'specificRows', 'summaryOverrides', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'monthKey', 'dateIso', 'hariKe', 'headerLine1', 'headerLine2',
          'headerLine3', 'headerAlamat', 'titleSpecific', 'titleSummary',
          'logoDataUrl', 'logoWidthPx', 'logoRightDataUrl', 'logoRightWidthPx',
          'followGlobalLeftLogo', 'followGlobalRightLogo',
          'specificRows', 'summaryOverrides', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.dateIso is string && data.dateIso.size() == 10 && data.dateIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.hariKe is int && data.hariKe >= 1 && data.hariKe <= 366
        && data.headerLine1 is string && data.headerLine1.size() <= 120
        && data.headerLine2 is string && data.headerLine2.size() <= 150
        && data.headerLine3 is string && data.headerLine3.size() <= 150
        && data.headerAlamat is string && data.headerAlamat.size() <= 250
        && data.titleSpecific is string && data.titleSpecific.size() <= 120
        && data.titleSummary is string && data.titleSummary.size() <= 120
        && (!('logoDataUrl' in data) || (data.logoDataUrl is string && data.logoDataUrl.size() <= 200000))
        && (!('logoWidthPx' in data) || isValidLogoWidth(data.logoWidthPx))
        && (!('logoRightDataUrl' in data) || (data.logoRightDataUrl is string && data.logoRightDataUrl.size() <= 200000))
        && (!('logoRightWidthPx' in data) || isValidLogoWidth(data.logoRightWidthPx))
        && (!('followGlobalLeftLogo' in data) || data.followGlobalLeftLogo is bool)
        && (!('followGlobalRightLogo' in data) || data.followGlobalRightLogo is bool)
        && data.specificRows is list && data.specificRows.size() <= 200
        && data.summaryOverrides is map && data.summaryOverrides.size() <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFoodCostDayPlan(data) {
      return data.keys().hasAll([
          'uid', 'monthKey', 'dateIso', 'hariKe', 'headerLine1', 'headerLine2',
          'headerLine3', 'headerAlamat', 'worksheets', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'monthKey', 'dateIso', 'hariKe', 'headerLine1', 'headerLine2',
          'headerLine3', 'headerAlamat',
          'logoDataUrl', 'logoWidthPx', 'logoRightDataUrl', 'logoRightWidthPx',
          'followGlobalLeftLogo', 'followGlobalRightLogo',
          'worksheets', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.dateIso is string && data.dateIso.size() == 10 && data.dateIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.hariKe is int && data.hariKe >= 1 && data.hariKe <= 366
        && data.headerLine1 is string && data.headerLine1.size() <= 120
        && data.headerLine2 is string && data.headerLine2.size() <= 150
        && data.headerLine3 is string && data.headerLine3.size() <= 150
        && data.headerAlamat is string && data.headerAlamat.size() <= 250
        && (!('logoDataUrl' in data) || (data.logoDataUrl is string && data.logoDataUrl.size() <= 200000))
        && (!('logoWidthPx' in data) || isValidLogoWidth(data.logoWidthPx))
        && (!('logoRightDataUrl' in data) || (data.logoRightDataUrl is string && data.logoRightDataUrl.size() <= 200000))
        && (!('logoRightWidthPx' in data) || isValidLogoWidth(data.logoRightWidthPx))
        && (!('followGlobalLeftLogo' in data) || data.followGlobalLeftLogo is bool)
        && (!('followGlobalRightLogo' in data) || data.followGlobalRightLogo is bool)
        && data.worksheets is list && data.worksheets.size() <= 30
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRawMaterialRecapDayConfig(data) {
      return data.keys().hasAll([
          'uid', 'monthKey', 'dateIso', 'hariKe', 'headerLine1', 'headerLine2',
          'headerLine3', 'headerAlamat', 'recapTitle', 'sideLabel', 'bufferPercent',
          'bumbuPercent', 'rabPorsiKecilRate', 'rabPorsiBesarRate', 'poJudul',
          'poDari', 'poKepada', 'poAlamat', 'poSignerLabel1', 'poSignerLabel2',
          'poSignerName', 'itemOverrides', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'monthKey', 'dateIso', 'hariKe', 'headerLine1', 'headerLine2',
          'headerLine3', 'headerAlamat',
          'logoDataUrl', 'logoWidthPx', 'logoRightDataUrl', 'logoRightWidthPx',
          'followGlobalLeftLogo', 'followGlobalRightLogo',
          'recapTitle', 'sideLabel',
          'bufferPercent', 'bumbuPercent', 'rabPorsiKecilRate', 'rabPorsiBesarRate',
          'poJudul', 'poDari', 'poKepada', 'poAlamat', 'poSignerLabel1', 'poSignerLabel2',
          'poSignerName', 'itemOverrides', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.dateIso is string && data.dateIso.size() == 10 && data.dateIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.hariKe is int && data.hariKe >= 1 && data.hariKe <= 366
        && data.headerLine1 is string && data.headerLine1.size() <= 120
        && data.headerLine2 is string && data.headerLine2.size() <= 150
        && data.headerLine3 is string && data.headerLine3.size() <= 150
        && data.headerAlamat is string && data.headerAlamat.size() <= 250
        && (!('logoDataUrl' in data) || (data.logoDataUrl is string && data.logoDataUrl.size() <= 200000))
        && (!('logoWidthPx' in data) || isValidLogoWidth(data.logoWidthPx))
        && (!('logoRightDataUrl' in data) || (data.logoRightDataUrl is string && data.logoRightDataUrl.size() <= 200000))
        && (!('logoRightWidthPx' in data) || isValidLogoWidth(data.logoRightWidthPx))
        && (!('followGlobalLeftLogo' in data) || data.followGlobalLeftLogo is bool)
        && (!('followGlobalRightLogo' in data) || data.followGlobalRightLogo is bool)
        && data.recapTitle is string && data.recapTitle.size() <= 150
        && data.sideLabel is string && data.sideLabel.size() <= 60
        && data.bufferPercent is number && data.bufferPercent >= 0 && data.bufferPercent <= 500
        && data.bumbuPercent is number && data.bumbuPercent >= 0 && data.bumbuPercent <= 500
        && data.rabPorsiKecilRate is number && data.rabPorsiKecilRate >= 0
        && data.rabPorsiBesarRate is number && data.rabPorsiBesarRate >= 0
        && data.poJudul is string && data.poJudul.size() <= 120
        && data.poDari is string && data.poDari.size() <= 150
        && data.poKepada is string && data.poKepada.size() <= 150
        && data.poAlamat is string && data.poAlamat.size() <= 250
        && data.poSignerLabel1 is string && data.poSignerLabel1.size() <= 100
        && data.poSignerLabel2 is string && data.poSignerLabel2.size() <= 150
        && data.poSignerName is string && data.poSignerName.size() <= 150
        && data.itemOverrides is map && data.itemOverrides.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMasterMenuPlan(data) {
      return data.keys().hasAll([
          'uid', 'monthKey', 'title', 'categoryIds', 'cycleMode',
          'headerLine1', 'headerLine2', 'headerLine3', 'headerAlamat',
          'rowLabels', 'weeks', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'monthKey', 'title', 'categoryIds', 'cycleMode',
          'headerLine1', 'headerLine2', 'headerLine3', 'headerAlamat',
          'logoDataUrl', 'logoWidthPx', 'logoRightDataUrl', 'logoRightWidthPx',
          'followGlobalLeftLogo', 'followGlobalRightLogo',
          'rowLabels', 'weeks', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.categoryIds is list
        && data.categoryIds.size() >= 1
        && data.categoryIds.size() <= 20
        && data.categoryIds.hasOnly([
          'tk_paud_lb', 'sd_1_3', 'sd_4_6', 'smp_mts', 'sma_smk',
          'pendidik', 'tendik', 'anak_balita', 'balita_13_59',
          'balita_6_11', 'ibu_hamil', 'ibu_menyusui'
        ])
        && data.cycleMode in ['1_minggu', '2_minggu', '3_minggu', '4_minggu', 'bulanan']
        && data.headerLine1 is string && data.headerLine1.size() <= 120
        && data.headerLine2 is string && data.headerLine2.size() <= 150
        && data.headerLine3 is string && data.headerLine3.size() <= 150
        && data.headerAlamat is string && data.headerAlamat.size() <= 250
        && (!('logoDataUrl' in data) || (data.logoDataUrl is string && data.logoDataUrl.size() <= 200000))
        && (!('logoWidthPx' in data) || isValidLogoWidth(data.logoWidthPx))
        && (!('logoRightDataUrl' in data) || (data.logoRightDataUrl is string && data.logoRightDataUrl.size() <= 200000))
        && (!('logoRightWidthPx' in data) || isValidLogoWidth(data.logoRightWidthPx))
        && (!('followGlobalLeftLogo' in data) || data.followGlobalLeftLogo is bool)
        && (!('followGlobalRightLogo' in data) || data.followGlobalRightLogo is bool)
        && data.rowLabels is map && data.rowLabels.size() <= 12
        && data.weeks is list && data.weeks.size() >= 1 && data.weeks.size() <= 6 && data.weeks[0] is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'email', 'reportTitle', 'namaSppg', 'idSppg',
          'alamat', 'kabKota', 'provinsi', 'namaSppi', 'nomorHp',
          'logoSettings', 'updatedAt'
        ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      // Settings Subcollection (e.g. TKPI spreadsheet sync config)
      match /settings/{settingId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(settingId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(settingId)
          && isValidTkpiSyncConfig(incoming())
          && incoming().updatedAt == request.time
          && (
            exists(/databases/$(database)/documents/users/$(userId))
            || existsAfter(/databases/$(database)/documents/users/$(userId))
          );

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(settingId)
          && isValidTkpiSyncConfig(incoming())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'spreadsheetUrl', 'lastSyncedAt', 'syncedItems', 'customItems', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(settingId);
      }

      // Monthly Archives Subcollection
      match /months/{monthId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(monthId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(monthId)
          && isValidMonthlyArchive(incoming())
          && incoming().monthKey == monthId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            exists(/databases/$(database)/documents/users/$(userId))
            || existsAfter(/databases/$(database)/documents/users/$(userId))
          );

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(monthId)
          && isValidMonthlyArchive(incoming())
          && incoming().uid == existing().uid
          && incoming().monthKey == existing().monthKey
          && incoming().year == existing().year
          && incoming().month == existing().month
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'periodeLabel', 'entryCount', 'photoCount', 'selectedCategories', 'akgTargets', 'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(monthId);

        // Daily Menu Entries Subcollection
        match /entries/{entryId} {
          allow get: if isOwner(userId) && isValidId(userId) && isValidId(monthId) && isValidId(entryId);
          allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

          allow create: if isOwner(userId)
            && isValidId(userId)
            && isValidId(monthId)
            && isValidId(entryId)
            && isValidDailyMenuEntry(incoming())
            && incoming().monthKey == monthId
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && (
              exists(/databases/$(database)/documents/users/$(userId)/months/$(monthId))
              || existsAfter(/databases/$(database)/documents/users/$(userId)/months/$(monthId))
            );

          allow update: if isOwner(userId)
            && isValidId(userId)
            && isValidId(monthId)
            && isValidId(entryId)
            && isValidDailyMenuEntry(incoming())
            && incoming().uid == existing().uid
            && incoming().monthKey == existing().monthKey
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'dateIso', 'hariKe', 'namaMenu', 'photoDataUrl', 'nutritionByCategory', 'updatedAt'
            ])
            && exists(/databases/$(database)/documents/users/$(userId)/months/$(monthId));

          allow delete: if isOwner(userId) && isValidId(userId) && isValidId(monthId) && isValidId(entryId);
        }

        // Editable Form Configs Subcollection (e.g. sampel_pertinggal)
        match /forms/{formId} {
          allow get: if isOwner(userId) && isValidId(userId) && isValidId(monthId) && isValidId(formId);
          allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

          allow create: if isOwner(userId)
            && isValidId(userId)
            && isValidId(monthId)
            && isValidId(formId)
            && isValidSampleFormConfig(incoming())
            && incoming().monthKey == monthId
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && (
              exists(/databases/$(database)/documents/users/$(userId)/months/$(monthId))
              || existsAfter(/databases/$(database)/documents/users/$(userId)/months/$(monthId))
            );

          allow update: if isOwner(userId)
            && isValidId(userId)
            && isValidId(monthId)
            && isValidId(formId)
            && isValidSampleFormConfig(incoming())
            && incoming().uid == existing().uid
            && incoming().monthKey == existing().monthKey
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'logoDataUrl', 'logoWidthPx', 'logoRightDataUrl', 'logoRightWidthPx',
              'followGlobalLeftLogo', 'followGlobalRightLogo',
              'logoCaption', 'unitName', 'formLabel', 'formTitle',
              'docNumber', 'revision', 'effectiveDate', 'bulanLabel', 'tahunLabel',
              'colLabels', 'verifierLine1', 'verifierLine2', 'verifierName', 'updatedAt'
            ])
            && exists(/databases/$(database)/documents/users/$(userId)/months/$(monthId));

          allow delete: if isOwner(userId) && isValidId(userId) && isValidId(monthId) && isValidId(formId);
        }

        // Sampel Pertinggal Rows Subcollection
        match /sampleRows/{rowId} {
          allow get: if isOwner(userId) && isValidId(userId) && isValidId(monthId) && isValidId(rowId);
          allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

          allow create: if isOwner(userId)
            && isValidId(userId)
            && isValidId(monthId)
            && isValidId(rowId)
            && isValidSamplePertinggalRow(incoming())
            && incoming().monthKey == monthId
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && (
              exists(/databases/$(database)/documents/users/$(userId)/months/$(monthId))
              || existsAfter(/databases/$(database)/documents/users/$(userId)/months/$(monthId))
            );

          allow update: if isOwner(userId)
            && isValidId(userId)
            && isValidId(monthId)
            && isValidId(rowId)
            && isValidSamplePertinggalRow(incoming())
            && incoming().uid == existing().uid
            && incoming().monthKey == existing().monthKey
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'rowOrder', 'kodeIdentitas', 'jumlahSampel', 'kondisiOk', 'kondisiNok',
              'penanggungJawab', 'masukTanggal', 'masukJam', 'keluarTanggal', 'keluarJam',
              'updatedAt'
            ])
            && exists(/databases/$(database)/documents/users/$(userId)/months/$(monthId));

          allow delete: if isOwner(userId) && isValidId(userId) && isValidId(monthId) && isValidId(rowId);
        }

        // Temperature Monitoring Form Config Subcollection
        match /tempForms/{formId} {
          allow get: if isOwner(userId) && isValidId(userId) && isValidId(monthId) && isValidId(formId);
          allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

          allow create: if isOwner(userId)
            && isValidId(userId)
            && isValidId(monthId)
            && isValidId(formId)
            && isValidTempFormConfig(incoming())
            && incoming().monthKey == monthId
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && (
              exists(/databases/$(database)/documents/users/$(userId)/months/$(monthId))
              || existsAfter(/databases/$(database)/documents/users/$(userId)/months/$(monthId))
            );

          allow update: if isOwner(userId)
            && isValidId(userId)
            && isValidId(monthId)
            && isValidId(formId)
            && isValidTempFormConfig(incoming())
            && incoming().uid == existing().uid
            && incoming().monthKey == existing().monthKey
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'logoDataUrl', 'logoWidthPx', 'logoRightDataUrl', 'logoRightWidthPx',
              'followGlobalLeftLogo', 'followGlobalRightLogo',
              'logoCaption', 'unitName', 'formLabel', 'formTitle',
              'docNumber', 'revision', 'effectiveDate', 'periodeLabel', 'tableLabels',
              'sopTitle', 'sopSubtitle', 'updatedAt'
            ])
            && exists(/databases/$(database)/documents/users/$(userId)/months/$(monthId));

          allow delete: if isOwner(userId) && isValidId(userId) && isValidId(monthId) && isValidId(formId);
        }

        // Temperature Monitoring Rooms Subcollection
        match /tempRooms/{roomId} {
          allow get: if isOwner(userId) && isValidId(userId) && isValidId(monthId) && isValidId(roomId);
          allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

          allow create: if isOwner(userId)
            && isValidId(userId)
            && isValidId(monthId)
            && isValidId(roomId)
            && isValidTempMonitoringRoom(incoming())
            && incoming().monthKey == monthId
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && (
              exists(/databases/$(database)/documents/users/$(userId)/months/$(monthId))
              || existsAfter(/databases/$(database)/documents/users/$(userId)/months/$(monthId))
            );

          allow update: if isOwner(userId)
            && isValidId(userId)
            && isValidId(monthId)
            && isValidId(roomId)
            && isValidTempMonitoringRoom(incoming())
            && incoming().uid == existing().uid
            && incoming().monthKey == existing().monthKey
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'roomOrder', 'roomName', 'presetKey', 'standardSuhu', 'standardRh',
              'sopNote', 'updatedAt'
            ])
            && exists(/databases/$(database)/documents/users/$(userId)/months/$(monthId));

          allow delete: if isOwner(userId) && isValidId(userId) && isValidId(monthId) && isValidId(roomId);

          // Daily Readings (1-31) Subcollection per Room
          match /days/{dayId} {
            allow get: if isOwner(userId) && isValidId(userId) && isValidId(monthId) && isValidId(roomId) && isValidId(dayId);
            allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

            allow create: if isOwner(userId)
              && isValidId(userId)
              && isValidId(monthId)
              && isValidId(roomId)
              && isValidId(dayId)
              && isValidTempDayReading(incoming())
              && incoming().monthKey == monthId
              && incoming().roomId == roomId
              && incoming().createdAt == request.time
              && incoming().updatedAt == request.time
              && (
                exists(/databases/$(database)/documents/users/$(userId)/months/$(monthId)/tempRooms/$(roomId))
                || existsAfter(/databases/$(database)/documents/users/$(userId)/months/$(monthId)/tempRooms/$(roomId))
              );

            allow update: if isOwner(userId)
              && isValidId(userId)
              && isValidId(monthId)
              && isValidId(roomId)
              && isValidId(dayId)
              && isValidTempDayReading(incoming())
              && incoming().uid == existing().uid
              && incoming().monthKey == existing().monthKey
              && incoming().roomId == existing().roomId
              && incoming().day == existing().day
              && incoming().createdAt == existing().createdAt
              && incoming().updatedAt == request.time
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'jam', 'suhu', 'rh', 'paraf', 'namaPetugas',
                'photoDataUrl', 'detectedNote', 'updatedAt'
              ])
              && exists(/databases/$(database)/documents/users/$(userId)/months/$(monthId)/tempRooms/$(roomId));

            allow delete: if isOwner(userId) && isValidId(userId) && isValidId(monthId) && isValidId(roomId) && isValidId(dayId);
          }
        }

        // Freezer & Chiller Form Config Subcollection
        match /freezerForms/{formId} {
          allow get: if isOwner(userId) && isValidId(userId) && isValidId(monthId) && isValidId(formId);
          allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

          allow create: if isOwner(userId)
            && isValidId(userId)
            && isValidId(monthId)
            && isValidId(formId)
            && isValidFreezerFormConfig(incoming())
            && incoming().monthKey == monthId
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && (
              exists(/databases/$(database)/documents/users/$(userId)/months/$(monthId))
              || existsAfter(/databases/$(database)/documents/users/$(userId)/months/$(monthId))
            );

          allow update: if isOwner(userId)
            && isValidId(userId)
            && isValidId(monthId)
            && isValidId(formId)
            && isValidFreezerFormConfig(incoming())
            && incoming().uid == existing().uid
            && incoming().monthKey == existing().monthKey
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'logoDataUrl', 'logoWidthPx', 'logoRightDataUrl', 'logoRightWidthPx',
              'followGlobalLeftLogo', 'followGlobalRightLogo',
              'logoCaption', 'unitName', 'formLabel', 'formTitle',
              'docNumber', 'revision', 'effectiveDate', 'periodeLabel', 'colLabels',
              'updatedAt'
            ])
