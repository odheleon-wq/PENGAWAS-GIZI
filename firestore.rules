                'jamCek2', 'suhu2', 'pic2',
                'jamCek3', 'suhu3', 'pic3',
                'keterangan', 'updatedAt'
              ])
              && exists(/databases/$(database)/documents/users/$(userId)/months/$(monthId)/freezerMachines/$(machineId));

            allow delete: if isOwner(userId) && isValidId(userId) && isValidId(monthId) && isValidId(machineId) && isValidId(rowId);
