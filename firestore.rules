              && isValidId(userId)
              && isValidId(monthId)
              && isValidId(machineId)
              && isValidId(rowId)
              && isValidFreezerLogRow(incoming())
              && incoming().uid == existing().uid
              && incoming().monthKey == existing().monthKey
