          "pattern": "^[0-9]{4}-[0-9]{2}$",
          "minLength": 7,
          "maxLength": 7
        },
        "dateIso": {
          "type": "string",
          "description": "Tanggal format YYYY-MM-DD.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "hariKe": {
          "type": "integer",
          "description": "Urutan Hari Ke dalam rekapan bulan."
        },
        "namaMenu": {
          "type": "string",
          "description": "Daftar komposisi nama menu harian.",
          "minLength": 1,
          "maxLength": 1000
        },
        "photoDataUrl": {
          "type": "string",
          "description": "Foto hasil krop rasio 3:2 seragam dalam format JPEG Data URL.",
          "maxLength": 350000
        },
        "nutritionByCategory": {
          "type": "object",
          "description": "Peta nilai gizi harian per ID kelompok sasaran."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp pembuatan entri."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp pembaruan entri."
        }
      },
      "required": [
        "uid",
        "monthKey",
        "dateIso",
        "hariKe",
        "namaMenu",
        "photoDataUrl",
        "createdAt",
        "updatedAt"
      ]
    },
