  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/SppgUserProfile"
      },
      "description": "Profil identitas SPPG yang terisolasi khusus untuk masing-masing email aktif."
    },
    "/users/{userId}/months/{monthId}": {
      "schema": {
        "$ref": "#/entities/MonthlyArchive"
      },
      "description": "Arsip bulanan milik pengguna yang merangkum entri, foto, dan konfigurasi gizi setiap bulan."
    },
    "/users/{userId}/months/{monthId}/entries/{entryId}": {
      "schema": {
        "$ref": "#/entities/DailyMenuEntry"
      },
      "description": "Catatan harian menu beserta foto serentak dan data nilai gizi per kategori."
    },
    "/users/{userId}/months/{monthId}/forms/{formId}": {
      "schema": {
        "$ref": "#/entities/SampleFormConfig"
      },
      "description": "Konfigurasi header, nomor dokumen, label kolom, dan verifikator Form Sampel Pertinggal."
    },
